# Flask sessiya kaliti (prod'da albatta o'zgartiring)
SECRET_KEY=change-me
# Bulutda PostgreSQL: postgresql://user:pass@host:5432/db  (bo'sh bo'lsa SQLite)
DATABASE_URL=
# HTTPS orqali ishlaganda 1 qiling
SESSION_COOKIE_SECURE=
# Telegram bot tokeni (@BotFather). Bo'sh bo'lsa — Sozlamalar → Telegram'da kiritiladi
TELEGRAM_BOT_TOKEN=
# Eslatmalar fon oqimini o'chirish uchun 0
TELEGRAM_SCHEDULER=1
